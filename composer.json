{
    "name": "alfacode-team/hkm-plugin-school-classes",
    "description": "The class catalog (12 sections), classes, subjects, sub-subjects and teacher-to-class grants.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\SchoolClasses\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plugins\\SchoolClasses\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
